# Keep the build context small: everything below is either generated inside the
# image (static/, ui/dist/) or irrelevant for the build.
.git
.github
.gitignore
.dockerignore

# Local runtime state and binaries
dev.db
*.db
kite
aerolink
# Cross-compiled / locally built binaries (bin/aerolink-<arch>…, ~120MB): the source-based
# build compiles inside the builder stage, so these are never inputs.
# （`make image-binary` 不用这个上下文，它用的是 dist/。）
/bin

# Local development credentials and overrides
# `config.dev.yaml` auto-creates admin/AdminPass!234, `dev.env*` holds development
# keys and `Makefile.local` is a machine-local build override.
dev.env
dev.env.local
dev.env.*.local
config.dev.yaml
Makefile.local

# Frontend build artefacts and dependencies
ui/node_modules
ui/dist
ui/.vite
# Rebuilt from ui/ inside the image; keeping it out also stops host-side stale
# assets from merging into the freshly built ones.
static

# Docs and test tooling
docs
e2e
charts
AGENTS.md
CLAUDE.md
*.log

# `make image-binary` stages the locally compiled binary (+ CA bundle) here and uses
# dist/ itself as the build context (Dockerfile.binary)；源码构建的上下文不该带上它。
/dist

# DuckDB static libraries ship per platform (~90MB each) and cgo links only the one
# matching the build platform (see lib/<platform>/prebuilt.go build tags). Dropping
# darwin/windows keeps ~265MB out of the build context. Add lib/linux-arm64 as well if
# the image is never built on arm64.
vendor/github.com/duckdb/duckdb-go-bindings/lib/darwin-amd64
vendor/github.com/duckdb/duckdb-go-bindings/lib/darwin-arm64
vendor/github.com/duckdb/duckdb-go-bindings/lib/windows-amd64
