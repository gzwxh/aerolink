# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

#SQLite dev.db
dev.db

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# Dependency directories (remove the comment below to include it)
vendor/

# Go workspace file
go.work

# IDE specific files
.idea/
.vscode/
*.swp
*.swo

# OS specific files
.DS_Store
Thumbs.db

# Kubernetes config
kubeconfig

static
bin

deploy-dev

values-*.yaml

docs/.vitepress/dist
docs/node_modules
docs/.vitepress/cache

# 根目录的构建产物（make build 的二进制）
/aerolink
# 旧名字的产物：二进制名从 kite 改成 aerolink 之前构建出来的，仍不进库
/kite
# 直接 `go build ./tools/rancherrbac/...` 会把它落在仓库根目录（Makefile 的
# rancherrbac 目标走 scripts/build-rancherrbac.sh，产物在 bin/）
/rancherrbac
!charts/aerolink

# 打包好的 Helm chart（`helm package charts/aerolink/` 会在仓库根目录生成
# aerolink-<chart version>.tgz，CI 自己打包并上传，不进版本库）
aerolink-*.tgz
charts/*.tgz

.gocache/
# 本地开发覆盖文件
dev.env.local
dev.env.*.local
Makefile.local
