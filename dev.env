# 本地开发默认环境变量（仅供本机调试，值刻意公开）。
#
# 用法：
#   make dev            # 后端(--v=5，改动自动重新编译重启) + Vite 前端，自动加载本文件
#   make run            # 仅后端，自动加载本文件
#   set -a; . ./dev.env; set +a; ./aerolink     # 手动启动
#
# ⚠️ 这些密钥只用于本地开发，任何真实环境都必须换成随机值：
#     openssl rand -base64 32

# 服务端口与数据库
PORT=8080
# 默认用仓库根目录的 SQLite 文件 dev.db：本地零依赖，数据都在文件里，随拷随走。
# 切到本机 PostgreSQL（容器 aerolink-pg-compat，宿主 55432，库 aerolink_compat）时改成：
#   DB_TYPE=postgres
#   DB_DSN="host=127.0.0.1 user=aerolink password=Compat@12345 dbname=aerolink_compat port=55432 sslmode=disable TimeZone=Asia/Shanghai"
# 原先的 5433（容器 aerolink-postgres12）本机已不存在，连它只会 connection refused。
# TimeZone 必须显式写：漏写不报错，但界面与审计日志的时间会整体偏移。
#
# 2026-10-13 起：切到 10.100.117.8 本机的 MySQL 实例（容器 dsyops-local-mysql，
# 映射 127.0.0.1:3306；root 密码见容器环境变量，这里用专用账号）。
# 库 aerolink 与账号 'aerolink'@'%' 已手动创建，表由服务首次启动自动迁移。
# 注意密码在单引号里原样传递；DSN 里 & 不能丢，parseTime 缺了时间字段会报错。
DB_TYPE=sqlite
DB_DSN=dev.db

# 数据加密密钥（≥32 字节）：服务端强制要求，缺失会拒绝启动。
# ⚠️ 这个值与 dev.db 绑定：库里的密文就是用它加密的，换成别的值会解不开、服务拒绝启动。
# 自动重加密只适用于「此前一直用内置默认密钥」的库，换自定义密钥并不适用。
AEROLINK_ENCRYPT_KEY=dev-only-encrypt-key-0123456789abcdef

# 会话签名密钥（≥32 字节）：服务端强制要求，缺失会自动生成随机值。
JWT_SECRET=dev-only-jwt-secret-0123456789abcdef

# 加载 config.dev.yaml：库为空时自动创建管理员 admin / AdminPass!234，
# 并播种 auditArchive（localDir=/var/log/aerolink/archive）；
# 集群为空时还会尝试导入 ~/.kube/config。
# 注意：设了它之后，环境变量建超管（AEROLINK_USERNAME/PASSWORD）与 KUBECONFIG 自动导入都失效，
# 超管改由本文件的 superUser 段负责。
AEROLINK_CONFIG_FILE=config.dev.yaml

# 需要排查内存/协程时打开（默认关闭，仅监听 127.0.0.1:6060）
# AEROLINK_ENABLE_PPROF=true

# 需要 Prometheus 抓取时设置；不设置则 /metrics 无鉴权（会打印告警）
# AEROLINK_METRICS_TOKEN=local-metrics-token

# 只在确实无法配置密钥时使用（会回退到内置默认密钥并打印告警）
# AEROLINK_ALLOW_INSECURE_SECRETS=true
# 审计日志的落地方式（五选一、互斥，启动时生效，管理页面只读）。取值：
#   database（默认）| parquet | elasticsearch | victorialogs | openobserve
# 下面这份本地开发配置用 parquet：不依赖任何外部组件，只落本地文件。
# 换成其它值时，请同时把所选通道的落地目标配好（不配会**拒绝启动**）：
#   parquet       → AEROLINK_AUDIT_ARCHIVE_DIR 或 config.yaml 的 auditArchive.localDir
#   elasticsearch → config.yaml 的 auditArchive.elasticsearch.urls
#   victorialogs  → config.yaml 的 auditArchive.victorialogs.urls（VictoriaLogs，不是 VictoriaMetrics）
#   openobserve   → config.yaml 的 auditArchive.openobserve.urls
AEROLINK_AUDIT_SINK=parquet

# parquet 模式的本地归档目录：sink=parquet 时**必须**有落点（库里的归档设置或这个环境变量，
# 二者皆无会拒绝启动）。本机以 root 运行，/var/log 可写；容器里用 /home/aerolink/data/archive。
AEROLINK_AUDIT_ARCHIVE_DIR=/var/log/aerolink/archive
